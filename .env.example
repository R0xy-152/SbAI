# docker compose 环境变量模板（复制为项目根目录 .env 使用；.env 不入库）
# 快速上线固定剧本版不需要任何 AI key：GAL_PROVIDER 缺省 auto，无 key 自动回落 mock。

# 前端对外端口。本机开发默认 8080；服务器直连可设 80；
# 若服务器上有上层 nginx/caddy 反代，保持 8080 并让反代指过来即可。
FRONTEND_PORT=8080

# 后端仅绑定宿主 loopback；通常保持 8000，平行验收时可换空闲端口。
BACKEND_PORT=8000

# AI 提供方：auto | mock | deepseek。快速上线版建议留 auto（无 key 即 mock）。
GAL_PROVIDER=auto

# 真实 DeepSeek 回复（结局后自由聊天 / 旧 AI 玩法）。留空 = 自动回落 mock。
# key 只存在于服务器环境变量，绝不入库。
DEEPSEEK_API_KEY=

# 后端额外 CORS 来源（逗号分隔）。同源部署（前端 nginx 反代 /api）无需设置。
# GAL_CORS_ORIGINS=https://your.domain

# postgres 密码（生产部署务必改成强密码；改动后需重建 postgres 卷）
# 注意：密码不要包含 @ : / 等字符——DSN 直接拼接，@ 会被解析成主机分隔符
# （实测含 @ 的密码导致 psycopg 把主机解析错、/api/saves 500）。
POSTGRES_PASSWORD=gal

# 邀请码 HMAC 服务端密钥（至少 32 随机字节；不得提交真实值）。可用：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GAL_AUTH_SECRET=replace-with-a-long-random-secret

# 当前受控 HTTP 展示暂为 false；切换可靠 HTTPS 后必须改为 true。
GAL_AUTH_COOKIE_SECURE=false

# 生产保持 true；仅隔离测试/本地兼容调试可设 false。
GAL_AUTH_REQUIRED=true
